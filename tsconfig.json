{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": "./src",
    "lib": [
      "es2020",
      "dom"
    ],
    "alwaysStrict": true,
    "noImplicitAny": true,
    "strictNullChecks": false,
    "useUnknownInCatchVariables": false,
    "sourceMap": true,
    "declaration": true,
    "preserveConstEnums": false,
  },
  "include": [
    "src/**/*.ts"
  ]
}